{
  "name": "ta-tex",
  "productName": "T. A. TEX",
  "version": "1.0.0",
  "description": "T. A. TEX billing software",
  "author": "T. A. TEX",
  "main": "electron/main.js",
  "scripts": {
    "electron": "electron .",
    "start": "electron-forge start",
    "build:fe": "npm --prefix fe run build",
    "build:be": "npm --prefix be run postinstall",
    "package": "electron-forge package",
    "package:win": "npm run build:fe && node scripts/stage-packaged-backend.js && node scripts/assemble-win-portable.js",
    "make": "electron-forge make",
    "make:zip": "electron-forge make --targets=@electron-forge/maker-zip"
  },
  "config": {
    "forge": "./forge.config.js"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "electron": "^44.3.0"
  }
}
